{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>codeandsolder/ci-workflows:renovate-ci-trust-root"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "separateMultipleMajor": true,
  "prConcurrentLimit": 4,
  "prHourlyLimit": 4,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "Keep pre-1.0 solver/cryptography dependencies reviewable",
      "matchManagers": [
        "cargo"
      ],
      "matchCurrentVersion": "/^0\\./",
      "automerge": false
    },
    {
      "description": "Major and replacement updates require review",
      "matchUpdateTypes": [
        "major",
        "replacement"
      ],
      "automerge": false
    }
  ]
}
